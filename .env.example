# Server port (AI Studio uses 3000)
PORT=3000

# MongoDB connection string (optional; falls back to in-memory seeded store if omitted)
MONGO_URI=

# Allowed CORS origin (optional)
ORIGIN=http://localhost:3000

# Email credentials for sending OTPs and password resets (optional; logs to console if omitted)
EMAIL=
PASSWORD=

# Token and cookie expiration settings
LOGIN_TOKEN_EXPIRATION=30d
OTP_EXPIRATION_TIME=120000
PASSWORD_RESET_TOKEN_EXPIRATION=2m
COOKIE_EXPIRATION_DAYS=30

# Secret key for JWT signing
JWT_SECRET=
SECRET_KEY=

# Set to true when serving over HTTPS
PRODUCTION=false

# Frontend API base URL (defaults to /api same-origin proxy)
REACT_APP_BASE_URL=/api
